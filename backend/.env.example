# Copy to .env and fill in. Never commit .env.
PORT=4000

# Either a full connection string (most hosts give you one)...
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DB_SSL=true
# ...or separate values for a local database:
DB_USER=postgres
DB_HOST=localhost
DB_NAME=expense_tracker_db
DB_PASSWORD=
DB_PORT=5432

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: enables xp's cloud brain. Without it xp still works on-device.
ANTHROPIC_API_KEY=
XP_MODEL=claude-opus-5-5
